# ==============================================================================
# COMPANY DATA ENRICHMENT CONFIGURATION (.env)
# ==============================================================================

# Your SerpAPI private API key (Get a free key from https://serpapi.com/)
SERPAPI_API_KEY=t2e4uJ3wesTsdhnq8Ziz39kT

# Path to your input Excel file (.xlsx)
EXCEL_FILE_PATH=./companies_sample.xlsx

# Sheet name (leave blank to use the active or first sheet)
SHEET_NAME=

# Save progress to Excel every N processed rows (e.g. 5)
SAVE_INTERVAL=5

# Randomized delay range between companies (in seconds) to avoid rate limiting
MIN_DELAY_SECONDS=2.0
MAX_DELAY_SECONDS=5.0

# Set to 'true' to test without an API key using simulated responses
MOCK_MODE=false

# If working behind a strict corporate SSL proxy with self-signed certs, set to false
SSL_VERIFY=true
